# Gemini API Key (Can also be configured by users directly in the UI Settings Vault)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model (defaults to gemini-3.8-flash)
DEFAULT_GEMINI_MODEL=gemini-3.8-flash

# Port (defaults to 3000)
PORT=3000
NODE_ENV=development

# Optional external scraper keys (system functions fully with built-in Google Grounding + Cheerio scraping if blank)
SERPAPI_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
